# ---------- Identity (all containers run as this non-root user) ----------
# Use IDs that may write to the NFS export (compatible with root_squash).
PUID=1000
PGID=1000

# ---------- Storage (host paths, may be NFS mounts) ----------
# Directories must exist and be writable by PUID:PGID.
MIRROR_DATA_DIR=/srv/mirrorhub/data
EXPORT_DIR=/srv/mirrorhub/export

# ---------- Network / TLS ----------
# Name clients use to reach MirrorHub; Caddy issues an internal-CA certificate for it.
MIRRORHUB_HOSTNAME=mirrorhub.lan
HTTPS_PORT=8443

# ---------- Application ----------
# Initial admin password. If empty, a one-time password is generated and printed to the web log.
MIRRORHUB_ADMIN_PASSWORD=
MIRRORHUB_ADMIN_USERNAME=admin
# Signs/encrypts secrets. If empty, one is generated once and stored on the state volume.
MIRRORHUB_SECRET_KEY=
# Logging: text | json
MIRRORHUB_LOG_FORMAT=text
MIRRORHUB_LOG_LEVEL=INFO

# ---------- Defaults (changeable later in the GUI Settings page) ----------
MIRRORHUB_GLOBAL_CONCURRENCY=2
MIRRORHUB_HEARTBEAT_INTERVAL_S=10
MIRRORHUB_HEARTBEAT_STALE_S=60
MIRRORHUB_LOG_RETENTION_DAYS=30

# Image tag
MIRRORHUB_TAG=dev