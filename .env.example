# ---------- Identity (all containers run as this non-root user) ----------
# Use IDs that may write to the NFS export (compatible with root_squash).
PUID=1000
PGID=1000

# ---------- Storage (host paths, may be NFS mounts) ----------
# Directories must exist and be writable by PUID:PGID.
HOST_DATA_DIR=/mnt/repository
HOST_EXPORT_DIR=/mnt/repository/export

# ---------- Network / TLS ----------
# Name clients use to reach MirrorHub; Caddy issues an internal-CA certificate for it.
MIRRORHUB_HOSTNAME=localhost
HTTPS_PORT=8443
# Private network between Caddy and the web container. The web container trusts
# X-Forwarded-For only from MIRRORHUB_PROXY_IP. If the subnet overlaps a local
# network, change all three: the proxy IP must be inside the subnet but outside
# the dynamic IP range, and must not be the gateway (.1).
MIRRORHUB_FRONTEND_SUBNET=172.31.254.0/28
MIRRORHUB_FRONTEND_IP_RANGE=172.31.254.8/29
MIRRORHUB_PROXY_IP=172.31.254.2
# Exact origin clients use; must match MIRRORHUB_HOSTNAME and HTTPS_PORT.
MIRRORHUB_PUBLIC_ORIGIN=https://localhost:8443

# ---------- Application ----------
# Initial admin password. If empty, a one-time password is generated and printed to the web log.
MIRRORHUB_ADMIN_PASSWORD=
MIRRORHUB_ADMIN_USERNAME=admin
# Signs/encrypts secrets. If empty, one is generated once and stored on the state volume.
MIRRORHUB_SECRET_KEY=
# Logging: text | json
MIRRORHUB_LOG_FORMAT=text
MIRRORHUB_LOG_LEVEL=INFO

# ---------- Defaults (changeable later in the GUI Settings page) ----------
MIRRORHUB_GLOBAL_CONCURRENCY=2
MIRRORHUB_HEARTBEAT_INTERVAL_S=10
MIRRORHUB_HEARTBEAT_STALE_S=60
MIRRORHUB_LOG_RETENTION_DAYS=30

# ---------- Universal sync worker ----------
# Number of universal worker containers. Each handles ftpsync, rsync, debmirror and wget.
MIRRORHUB_WORKER_REPLICAS=3
# Maximum number of sync jobs one worker process runs concurrently.
MIRRORHUB_WORKER_CONCURRENCY=1

# Image tag
MIRRORHUB_TAG=dev
