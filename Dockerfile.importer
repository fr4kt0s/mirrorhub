# Receiver-side importer (CLI only, standard library). Not a production-ready image.
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends zstd gpgv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY src/mirrorhub/__init__.py src/mirrorhub/verify.py /app/mirrorhub/
COPY src/mirrorhub/importer /app/mirrorhub/importer
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    MIRRORHUB_IMPORTER_CONFIG=/config/importer.toml

USER 10001:10001
ENTRYPOINT ["python", "-m", "mirrorhub.importer"]
