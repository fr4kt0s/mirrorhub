"""Application settings loaded from the environment.

Bare variables such as ``EXPORT_DIR`` are read through ``validation_alias``,
which bypasses ``env_prefix`` and avoids the silent-default trap.
"""

from __future__ import annotations

import logging
from functools import lru_cache
from pathlib import Path

from pydantic import Field, field_validator
from pydantic_settings import BaseSettings, SettingsConfigDict

log = logging.getLogger("mirrorhub.settings")


class Settings(BaseSettings):
    model_config = SettingsConfigDict(
        env_file=".env",
        env_file_encoding="utf-8",
        env_prefix="MIRRORHUB_",
        extra="ignore",
    )

    database_url: str = Field(
        default="postgresql+psycopg://mirrorhub:mirrorhub@db/mirrorhub",
        validation_alias="DATABASE_URL",
    )
    secret_key: str = Field(
        default="change-me",
        validation_alias="SECRET_KEY",
    )
    mirror_data_dir: Path = Field(
        default=Path("/data"),
        validation_alias="MIRROR_DATA_DIR",
    )
    export_dir: Path = Field(
        default=Path("/export"),
        validation_alias="EXPORT_DIR",
    )
    gnupg_dir: Path = Field(
        default=Path("/gnupg"),
        validation_alias="GNUPGHOME",
    )
    log_dir: Path = Field(
        default=Path("/var/lib/mirrorhub/logs"),
        validation_alias="LOG_DIR",
    )
    bind_host: str = Field(default="0.0.0.0", validation_alias="BIND_HOST")
    bind_port: int = Field(default=8000, validation_alias="BIND_PORT")
    data_uid: int = Field(default=1000, validation_alias="DATA_UID")
    data_gid: int = Field(default=1000, validation_alias="DATA_GID")

    @field_validator(
        "mirror_data_dir",
        "export_dir",
        "gnupg_dir",
        "log_dir",
        mode="after",
    )
    @classmethod
    def _absolute(cls, value: Path) -> Path:
        if not value.is_absolute():
            raise ValueError(f"path must be absolute: {value}")
        return value

    def ensure_directories(self) -> None:
        """Create the writable roots and report the resolved layout once."""
        for path in (
            self.mirror_data_dir,
            self.export_dir,
            self.gnupg_dir,
            self.log_dir,
        ):
            try:
                path.mkdir(parents=True, exist_ok=True)
            except PermissionError:
                log.error("directory not writable: %s", path)
                raise

        log.info(
            "resolved paths: data=%s export=%s gnupg=%s logs=%s",
            self.mirror_data_dir,
            self.export_dir,
            self.gnupg_dir,
            self.log_dir,
        )


@lru_cache(maxsize=1)
def get_settings() -> Settings:
    return Settings()